{
  "name": "serverless-image-resizer",
  "version": "1.0.0",
  "description": "Redimensionador automático de imágenes con Amazon S3, AWS Lambda, TypeScript y Sharp.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "tsc -b --clean",
    "package:lambda": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-lambda.ps1"
  },
  "keywords": [
    "aws",
    "lambda",
    "s3",
    "sharp",
    "serverless",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
